<script>
function setTheme(theme) {
  const root = document.documentElement;
  const logo = document.querySelector('.mindlens-logo');
  const heroTitle = document.querySelector('.hero-title');
  const heroSubtitle = document.querySelector('.hero-subtitle');
  const themeDropdown = document.querySelector('.theme-dropdown');
  const accountDropdown = document.querySelector('.account-dropdown');

  let accent = '#ff6b81'; 
  let bg = '#fff0f5';
  let text = '#2d3436';
  let dropdownText = '#2d3436';

  if (theme === 'blush') {
    bg = '#fff0f5';
    accent = '#ff6b81';
  } 
  else if (theme === 'midnight') {
    bg = '#1e1e2f';
    accent = '#a29bfe';
    dropdownText = '#ffffff'; 
  } 
  else if (theme === 'forest') {
    bg = '#eafaf1';
    accent = '#00b894';
  } 
  else if (theme === 'ocean') {
    bg = '#e3f2fd';
    accent = '#0984e3';
  } 
  else if (theme === 'clay') {
    bg = '#fbeee0';
    accent = '#d35400';
  }

  root.style.setProperty('--bg', bg);
  root.style.setProperty('--text', text);
  root.style.setProperty('--accent', accent);

  if (heroTitle && heroSubtitle) {
    if (theme === 'midnight') {
      heroTitle.style.color = '#ffffff';
      heroSubtitle.style.color = '#ffffff';
    } else {
      heroTitle.style.color = 'var(--title-color)';
      heroSubtitle.style.color = 'var(--text)';
    }
  }

  [themeDropdown, accountDropdown].forEach(dropdown => {
    if (dropdown) {
      dropdown.style.backgroundColor = bg;
      dropdown.style.borderColor = accent;
      dropdown.style.color = dropdownText;
    }
  });

  if (logo) logo.style.color = accent;

  localStorage.setItem('theme', theme);
}

document.addEventListener("DOMContentLoaded", () => {
  const savedTheme = localStorage.getItem('theme') || 'clay';
  const themeDropdown = document.querySelector('.theme-dropdown');
  const accountDropdown = document.querySelector('.account-dropdown');
  if (themeDropdown) themeDropdown.value = savedTheme;
  setTheme(savedTheme);
});

function handleAccountAction(path) {
  if (path && path !== '-') {
    window.location.href = path;
  }
}
</script>
