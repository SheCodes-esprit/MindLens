                                   id="current_password" name="current_password" 
                                   placeholder="Enter your current password">
                            {% if password_errors.current_password %}
                            <div class="invalid-feedback">{{ password_errors.current_password }}</div>
                            {% endif %}
                        </div>
                        <div class="form-group">
                            <label for="new_password">
                                <i class="bi bi-key me-2"></i>New Password
                            </label>
                            <input type="password" class="form-control {% if password_errors.new_password %}is-invalid{% endif %}" 
                                   id="new_password" name="new_password" 
                                   placeholder="Enter new password">
                            {% if password_errors.new_password %}
                            <div class="invalid-feedback">{{ password_errors.new_password }}</div>
                            {% endif %}
                        </div>
                        <div class="form-group">
                            <label for="confirm_password">
                                <i class="bi bi-key-fill me-2"></i>Confirm New Password
                            </label>
                            <input type="password" class="form-control {% if password_errors.confirm_password %}is-invalid{% endif %}" 
                                   id="confirm_password" name="confirm_password" 
                                   placeholder="Confirm new password">
                            {% if password_errors.confirm_password %}
                            <div class="invalid-feedback">{{ password_errors.confirm_password }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="form-actions mt-3">
                        <button type="button" class="btn btn-outline-secondary me-2" onclick="togglePasswordForm()">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </div>
                </div>
                
                <button type="button" class="btn btn-outline-primary" onclick="togglePasswordForm()" id="change-password-btn">
                    Change Password
                </button>
            </div>

                        <div class="security-item">
                            <div class="security-info">
                                <h6>Two-Factor Authentication</h6>
                                <p>Add an extra layer of security to your account</p>
                            </div>
