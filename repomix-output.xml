<file path="static/css/main.css">
:root {
  --bg: #fff;
  --text: #2d3436;
  --title-color: var(--text);
  --card-title-color: var(--text);
  --card-body-color: var(--text);
  --quote-color: var(--accent);
}


body {
  font-family: 'Inter', sans-serif;
  background-color: var(--bg);
  color: var(--text);
  transition: background 0.5s ease, color 0.5s ease;
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: 3rem;
  margin-bottom: 0.5rem;
  color: var(--title-color);
}

.hero-subtitle {
  font-size: 1.2rem;
  color: var(--text);
}

.quote-script {
  font-family: 'Great Vibes', cursive;
  font-size: 1.5rem;
  color: var(--quote-color);
}

.floating-icons {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.float-icon {
  position: absolute;
  font-size: 2rem;
  opacity: 0.6;
  animation: float 6s infinite ease-in-out;
}

.float-icon:nth-child(1) { top: 10%; left: 20%; color: var(--accent); }
.float-icon:nth-child(2) { top: 30%; left: 70%; color: var(--accent); }
.float-icon:nth-child(3) { top: 60%; left: 40%; color: var(--accent); }

@keyframes float {
  0% { transform: translateY(0); }
  50% { transform: translateY(-20px); }
  100% { transform: translateY(0); }
}


.entries .entry-card,
.feature-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  z-index: 1;
}

.feature-card {
  text-align: center;
  padding: 2rem;
}

.entries .entry-card:hover,
.feature-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 36px rgba(0,0,0,0.08);
}

.entry-card h5,
.feature-card h5 {
  color: var(--card-title-color);
}

.entry-card p,
.feature-card p {
  color: var(--card-body-color);
}

.theme-dropdown,
.account-dropdown {
  width: 180px;
  font-weight: 600;
  border-radius: 6px;
  border: 2px solid var(--accent);
  background-color: var(--bg);
  color: var(--text);
  transition: border 0.3s ease, background 0.3s ease;
}

.theme-dropdown:focus,
.account-dropdown:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.25);
}
.account-dropdown option {
  background-color: var(--bg);
  color: var(--text);
  font-weight: 500;
  padding: 0.5rem;
  border-bottom: 1px solid #ccc;
}

.account-dropdown option:hover,
.account-dropdown option:focus {
  background-color: var(--accent);
  color: #fff;
}

.text-accent {
  color: var(--accent);
}

.footer,
.footer h6,
.footer p,
.footer ul,
.footer li,
.footer a {
  color: #2d3436 !important;
}

.footer-link {
  text-decoration: none;
  color: #2d3436 !important;
  font-size: 0.9rem;
  transition: color 0.3s ease;
}

.footer-link:hover {
  color: var(--accent) !important;
  text-decoration: underline;
}

nav.navbar .navbar-brand.mindlens-logo {
  color: var(--accent) !important;
  font-family: 'Playfair Display', serif !important;
}

nav.navbar .nav-link {
  color: var(--text) !important;
  text-decoration: none !important;
  transition: color 0.3s ease !important;
}

nav.navbar .nav-link:hover {
  color: var(--accent) !important;
}

nav.navbar .theme-dropdown,
nav.navbar .account-dropdown {
  width: 180px !important;
  font-weight: 600 !important;
  border-radius: 6px !important;
  border: 2px solid var(--accent) !important;
  background-color: var(--bg) !important;
  color: var(--text) !important;
  transition: border 0.3s ease, background 0.3s ease !important;
}

nav.navbar .theme-dropdown:focus,
nav.navbar .account-dropdown:focus {
  border-color: var(--accent) !important;
  box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.25) !important;
}

nav.navbar .account-dropdown option {
  background-color: var(--bg) !important;
  color: var(--text) !important;
  font-weight: 500 !important;
  padding: 0.5rem !important;
}

nav.navbar .account-dropdown option:hover,
nav.navbar .account-dropdown option:focus {
  background-color: var(--accent) !important;
  color: #fff !important;
}

:root {
  --bg: #fff;
  --text: #2d3436;
  --accent: #ff6b81;
}
