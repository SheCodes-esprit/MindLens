/* Audio Journal Page Styles */

/* Hero Section */
.audio-hero {
  position: relative;
  background: linear-gradient(135deg, var(--bg) 0%, #f8f9fa 100%);
  padding: 4rem 0;
  margin-bottom: 3rem;
  overflow: hidden;
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
}

.audio-hero h2 {
  font-family: "Playfair Display", serif;
  font-size: 3rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 1rem;
  position: relative;
  z-index: 2;
}

/* Floating Icons Animation */
.floating-icons {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.float-icon {
  position: absolute;
  font-size: 2.5rem;
  opacity: 0.15;
  animation: float 15s infinite ease-in-out;
  color: var(--accent);
}

.float-icon:nth-child(1) {
  top: 20%;
  left: 10%;
  animation-delay: 0s;
  animation-duration: 12s;
}

.float-icon:nth-child(2) {
  top: 60%;
  left: 20%;
  animation-delay: 2s;
  animation-duration: 14s;
}

.float-icon:nth-child(3) {
  top: 40%;
  right: 15%;
  animation-delay: 4s;
  animation-duration: 16s;
}

.float-icon:nth-child(4) {
  top: 70%;
  right: 25%;
  animation-delay: 6s;
  animation-duration: 13s;
}

.float-icon:nth-child(5) {
  top: 30%;
  left: 50%;
  animation-delay: 8s;
  animation-duration: 15s;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-30px) rotate(5deg);
  }
  50% {
