                                <button class="btn btn-outline-primary">Enable 2FA</button>
                            </div>
                        </div>

                        <div class="security-item">
                            <div class="security-info">
                                <h6>Active Sessions</h6>
                                <p>Manage devices that are logged into your account</p>
                            </div>
                            <button class="btn btn-outline-primary">View Sessions</button>
                        </div>
                    </div>
                </div>

                <div class="settings-section profile-card animate__animated animate__fadeInRight">
