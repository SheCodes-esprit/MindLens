                                <h6>Deactivate Account</h6>
                                <p>Temporarily disable your account</p>
                            </div>
                            <button class="btn btn-outline-secondary">Deactivate</button>
                        </div>

                        <div class="account-item danger-zone">
                            <div class="account-info">
                                <h6>Delete Account</h6>
                                <p>Permanently delete your account and all data</p>
                                <small class="text-muted">This action cannot be undone</small>
                            </div>
                            <button class="btn btn-danger">Delete Account</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const profileImageInput = document.getElementById('profile_image');
    const profileAvatar = document.getElementById('profile-avatar');
    
    if (profileImageInput && profileAvatar) {
        profileImageInput.addEventListener('change', function(e) {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    profileAvatar.src = e.target.result;
                };
                reader.readAsDataURL(this.files[0]);
                
                this.form.submit();
            }
        });
    }
});
function togglePasswordForm() {
    const passwordForm = document.getElementById('password-form');
    const changePasswordBtn = document.getElementById('change-password-btn');
    
    if (passwordForm.style.display === 'none') {
        passwordForm.style.display = 'block';
        changePasswordBtn.style.display = 'none';
        
        const inputs = passwordForm.querySelectorAll('input');
        inputs.forEach(input => {
            input.value = '';
            input.classList.remove('is-invalid');
        });
        
        const errorMessages = passwordForm.querySelectorAll('.invalid-feedback');
        errorMessages.forEach(error => error.style.display = 'none');
    } else {
        passwordForm.style.display = 'none';
        changePasswordBtn.style.display = 'block';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const toastElList = document.querySelectorAll('.toast');
    const toastList = [...toastElList].map(toastEl => {
        const toast = new bootstrap.Toast(toastEl);
        toast.show();
        return toast;
    });
    
    toastElList.forEach(toastEl => {
        toastEl.addEventListener('hidden.bs.toast', function() {
            this.remove();
        });
    });
    
    const profileImageInput = document.getElementById('profile_image');
    const profileAvatar = document.getElementById('profile-avatar');
    
    if (profileImageInput && profileAvatar) {
        profileImageInput.addEventListener('change', function(e) {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    profileAvatar.src = e.target.result;
                };
                reader.readAsDataURL(this.files[0]);
            }
        });
    }
    
    const successMessages = document.querySelectorAll('.toast-body');
    let passwordSuccess = false;
    
    successMessages.forEach(message => {
        if (message.textContent.includes('Password updated') || 
            message.textContent.includes('Profile updated') ||
            message.textContent.includes('Profile image updated')) {
            passwordSuccess = true;
        }
    });
    
    if (passwordSuccess) {
        const passwordForm = document.getElementById('password-form');
        const changePasswordBtn = document.getElementById('change-password-btn');
        
        if (passwordForm && changePasswordBtn) {
            passwordForm.style.display = 'none';
            changePasswordBtn.style.display = 'block';
        }
    }
});

function togglePasswordForm() {
    const passwordForm = document.getElementById('password-form');
    const changePasswordBtn = document.getElementById('change-password-btn');
    
    if (passwordForm.style.display === 'none') {
        passwordForm.style.display = 'block';
        changePasswordBtn.style.display = 'none';
        
        const inputs = passwordForm.querySelectorAll('input');
        inputs.forEach(input => {
            input.value = '';
            input.classList.remove('is-invalid');
        });
        
        const errorMessages = passwordForm.querySelectorAll('.invalid-feedback');
        errorMessages.forEach(error => error.style.display = 'none');
    } else {
        passwordForm.style.display = 'none';
        changePasswordBtn.style.display = 'block';
    }
}
</script>
{% endblock %}
</file>

