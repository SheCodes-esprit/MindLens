              </div>
          </form>

          <div class="floating-icons">
            <i class="bi bi-heart-fill float-icon"></i>
            <i class="bi bi-stars float-icon"></i>
            <i class="bi bi-emoji-smile float-icon"></i>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
