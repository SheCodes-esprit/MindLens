{% extends 'frontoffice/layouts/base.html' %}
{% load static %}

{% block title %}Ajouter une recommandation{% endblock %}

{% block content %}
<link rel="stylesheet" href="{% static 'css/main.css' %}">

<div style="max-width: 800px; margin: 0 auto; padding: 3rem 1rem;">
    <div class="entry-card">
        <div style="background: #27ae60; color: white; padding: 1.5rem; border-radius: 12px 12px 0 0; margin: -1.5rem -1.5rem 1.5rem -1.5rem;">
            <h3 style="margin: 0 0 0.5rem 0; font-size: 1.8rem; font-weight: 600;">💡 Nouvelle recommandation</h3>
            <small style="opacity: 0.9;">Pour l'enregistrement du {{ record.date|date:"d/m/Y" }}</small>
        </div>

        {% if messages %}
            {% for message in messages %}
            <div style="background: #d4edda; border-left: 4px solid #28a745; padding: 1rem; margin-bottom: 1rem; border-radius: 8px;">
                {{ message }}
            </div>
            {% endfor %}
        {% endif %}

        <form method="post" novalidate>
            {% csrf_token %}
            
            <div style="margin-bottom: 1.5rem;">
                <label for="{{ form.type.id_for_label }}" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text);">
                    🏷️ {{ form.type.label }}
                </label>
                {{ form.type }}
                {% if form.type.errors %}
                    <div style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.25rem;">
                        {{ form.type.errors }}
                    </div>
                {% endif %}
                <small style="color: var(--text); opacity: 0.7; display: block; margin-top: 0.25rem;">
                    Choisissez le type de routine recommandée
                </small>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label for="{{ form.description.id_for_label }}" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text);">
                    📝 {{ form.description.label }}
                </label>
                {{ form.description }}
                {% if form.description.errors %}
                    <div style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.25rem;">
                        {{ form.description.errors }}
                    </div>
                {% endif %}
                <small style="color: var(--text); opacity: 0.7; display: block; margin-top: 0.25rem;">
                    Décrivez la recommandation en détail
                </small>
            </div>

            <div style="margin-bottom: 2rem;">
                <label for="{{ form.efficiency_score.id_for_label }}" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text);">
                    ⭐ {{ form.efficiency_score.label }}
                </label>
                {{ form.efficiency_score }}
                {% if form.efficiency_score.errors %}
                    <div style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.25rem;">
                        {{ form.efficiency_score.errors }}
                    </div>
                {% endif %}
                <small style="color: var(--text); opacity: 0.7; display: block; margin-top: 0.25rem;">
                    Score d'efficacité estimé (0.0 à 1.0)
                </small>
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="submit" 
                        style="flex: 1; background: #27ae60; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: opacity 0.3s;">
                    ✅ Ajouter la recommandation
                </button>
                <a href="{% url 'wellbeing:wellbeing_detail' record.pk %}" 
                   style="flex: 1; text-align: center; background: #6c757d; color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600; transition: opacity 0.3s;">
                    ❌ Annuler
                </a>
            </div>
        </form>
    </div>

    <div class="feature-card" style="margin-top: 2rem; border: 2px solid var(--accent);">
        <h5 style="color: var(--card-title-color); margin-bottom: 1rem;">💡 Exemples de recommandations</h5>
        <ul style="text-align: left; color: var(--card-body-color); line-height: 1.8;">
            <li><strong>Routine matinale:</strong> "Commencer la journée par 10 minutes de méditation"</li>
            <li><strong>Exercice:</strong> "30 minutes de marche rapide après le déjeuner"</li>
            <li><strong>Sommeil:</strong> "Éteindre les écrans 1h avant le coucher"</li>
            <li><strong>Productivité:</strong> "Utiliser la technique Pomodoro (25min focus + 5min pause)"</li>
        </ul>
    </div>
</div>
{% endblock %}
</file>

