{% extends 'frontoffice/layouts/base.html' %}
{% load static %}

{% block title %}Enregistrement du {{ record.date|date:"d/m/Y" }}{% endblock %}

{% block content %}
<link rel="stylesheet" href="{% static 'css/main.css' %}">

<div style="max-width: 1200px; margin: 0 auto; padding: 3rem 1rem;">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
        <div>
            <div class="entry-card" style="margin-bottom: 2rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 class="hero-title" style="font-size: 2rem; margin: 0;">
                        📅 {{ record.date|date:"d F Y" }}
                    </h3>
                    <div style="display: flex; gap: 0.5rem;">
                        <a href="{% url 'wellbeing:wellbeing_update' record.pk %}" 
                           style="background: #3498db; color: white; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 500;">
                            ✏️ Modifier
                        </a>
                        <a href="{% url 'wellbeing:wellbeing_delete' record.pk %}" 
                           style="background: #e74c3c; color: white; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 500;">
                            🗑️ Supprimer
                        </a>
                    </div>
                </div>

                {% if messages %}
                    {% for message in messages %}
                    <div style="background: #d4edda; border-left: 4px solid #28a745; padding: 1rem; margin-bottom: 1rem; border-radius: 8px;">
                        {{ message }}
                    </div>
                    {% endfor %}
                {% endif %}

                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-bottom: 2rem;">
                    <div class="feature-card" style="border: 2px solid #3498db;">
                        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">😊</div>
                        <h4 style="margin: 0.5rem 0; font-size: 2rem; color: #3498db;">{{ record.mood_score }}/10</h4>
                        <p style="margin: 0; color: var(--text); opacity: 0.7;">Humeur</p>
                        <div style="background: #e0e0e0; height: 10px; border-radius: 5px; overflow: hidden; margin-top: 0.75rem;">
                            <div style="background: #3498db; height: 100%; width: {{ record.mood_score }}0%;"></div>
                        </div>
                    </div>

                    <div class="feature-card" style="border: 2px solid #f39c12;">
                        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">⚡</div>
                        <h4 style="margin: 0.5rem 0; font-size: 2rem; color: #f39c12;">{{ record.energy_level }}/10</h4>
                        <p style="margin: 0; color: var(--text); opacity: 0.7;">Niveau d'énergie</p>
                        <div style="background: #e0e0e0; height: 10px; border-radius: 5px; overflow: hidden; margin-top: 0.75rem;">
                            <div style="background: #f39c12; height: 100%; width: {{ record.energy_level }}0%;"></div>
                        </div>
                    </div>

                    <div class="feature-card" style="border: 2px solid #95a5a6;">
                        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🌙</div>
                        <h4 style="margin: 0.5rem 0; font-size: 2rem; color: #95a5a6;">{{ record.sleep_hours }}h</h4>
                        <p style="margin: 0; color: var(--text); opacity: 0.7;">Heures de sommeil</p>
                    </div>

                    <div class="feature-card" style="border: 2px solid #27ae60;">
                        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">📈</div>
                        <h4 style="margin: 0.5rem 0; font-size: 2rem; color: #27ae60;">{{ record.productivity_score }}/10</h4>
                        <p style="margin: 0; color: var(--text); opacity: 0.7;">Productivité</p>
                        <div style="background: #e0e0e0; height: 10px; border-radius: 5px; overflow: hidden; margin-top: 0.75rem;">
                            <div style="background: #27ae60; height: 100%; width: {{ record.productivity_score }}0%;"></div>
                        </div>
                    </div>
                </div>

                {% if record.ai_summary %}
                <div style="background: #f8f9fa; padding: 1.5rem; border-radius: 12px; border-left: 4px solid var(--accent);">
                    <h5 style="color: var(--card-title-color); margin-bottom: 0.75rem;">🤖 Résumé IA</h5>
                    <p style="margin: 0; color: var(--card-body-color); line-height: 1.6;">{{ record.ai_summary }}</p>
                </div>
                {% endif %}
            </div>

            <div class="entry-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h4 style="color: var(--card-title-color); margin: 0; font-size: 1.5rem;">💡 Recommandations de routine</h4>
                    <a href="{% url 'wellbeing:recommendation_create' record.pk %}" 
                       style="background: #27ae60; color: white; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 500;">
                        + Ajouter
                    </a>
                </div>

                {% if recommendations %}
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        {% for recommendation in recommendations %}
                        <div style="background: #f8f9fa; padding: 1.25rem; border-radius: 10px; border-left: 4px solid var(--accent);">
                            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.75rem;">
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <span style="background: var(--accent); color: white; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.85rem; font-weight: 600;">
                                        {{ recommendation.get_type_display }}
                                    </span>
                                    {% if recommendation.ai_generated %}
                                    <span style="background: #3498db; color: white; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.85rem; font-weight: 600;">
                                        🤖 IA
                                    </span>
                                    {% endif %}
                                </div>
                                <small style="color: var(--text); opacity: 0.6;">{{ recommendation.created_at|date:"d/m/Y H:i" }}</small>
                            </div>
                            <p style="margin-bottom: 0.5rem; color: var(--card-body-color); line-height: 1.6;">{{ recommendation.description }}</p>
                            <small style="color: var(--text); opacity: 0.7;">
                                ⭐ Efficacité: {{ recommendation.efficiency_score|floatformat:2 }}
                            </small>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div style="text-align: center; padding: 3rem 1rem;">
                        <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;">📭</div>
                        <p style="color: var(--text); opacity: 0.7; margin-bottom: 1.5rem;">Aucune recommandation pour le moment</p>
                        <a href="{% url 'wellbeing:recommendation_create' record.pk %}" 
                           style="display: inline-block; background: #27ae60; color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600;">
                            + Ajouter une recommandation
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>

        <div>
            <div class="entry-card" style="margin-bottom: 1.5rem;">
                <h5 style="color: var(--card-title-color); margin-bottom: 1rem; font-size: 1.2rem;">⚙️ Actions</h5>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <a href="{% url 'wellbeing:wellbeing_list' %}" class="footer-link" style="padding: 0.75rem; background: #f8f9fa; border-radius: 6px; display: block;">
                        ← Retour à la liste
                    </a>
                    <a href="{% url 'wellbeing:wellbeing_update' record.pk %}" class="footer-link" style="padding: 0.75rem; background: #f8f9fa; border-radius: 6px; display: block;">
                        ✏️ Modifier cet enregistrement
                    </a>
                    <a href="{% url 'wellbeing:wellbeing_create' %}" class="footer-link" style="padding: 0.75rem; background: #f8f9fa; border-radius: 6px; display: block;">
                        + Nouvel enregistrement
                    </a>
                    <a href="{% url 'wellbeing:wellbeing_delete' record.pk %}" class="footer-link" style="padding: 0.75rem; background: #ffe6e6; border-radius: 6px; display: block; color: #e74c3c !important;">
                        🗑️ Supprimer
                    </a>
                </div>
            </div>

            <div class="feature-card" style="border: 2px solid var(--accent);">
                <h5 style="color: var(--card-title-color); margin-bottom: 1rem;">📊 Statistiques</h5>
                <p style="margin-bottom: 0.5rem; color: var(--card-body-color);">
                    <strong>Score moyen:</strong> 
                    {% widthratio record.mood_score|add:record.energy_level|add:record.productivity_score 3 1 %}/10
                </p>
                <p style="margin: 0; color: var(--card-body-color);">
                    <strong>Recommandations:</strong> {{ recommendations|length }}
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/frontoffice/pages/wellbeing/wellbeing_form.html">
{% extends 'frontoffice/layouts/base.html' %}
{% load static %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<link rel="stylesheet" href="{% static 'css/main.css' %}">

<div style="max-width: 800px; margin: 0 auto; padding: 3rem 1rem;">
    <div class="entry-card">
        <div style="background: var(--accent); color: white; padding: 1.5rem; border-radius: 12px 12px 0 0; margin: -1.5rem -1.5rem 1.5rem -1.5rem;">
            <h3 style="margin: 0; font-size: 1.8rem; font-weight: 600;">💚 {{ title }}</h3>
        </div>

        {% if messages %}
            {% for message in messages %}
            <div style="background: #d4edda; border-left: 4px solid #28a745; padding: 1rem; margin-bottom: 1rem; border-radius: 8px;">
                {{ message }}
            </div>
            {% endfor %}
        {% endif %}

        <form method="post" novalidate>
            {% csrf_token %}
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
                <div>
                    <label for="{{ form.mood_score.id_for_label }}" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text);">
                        😊 {{ form.mood_score.label }}
                    </label>
                    {{ form.mood_score }}
                    {% if form.mood_score.errors %}
                        <div style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.25rem;">
                            {{ form.mood_score.errors }}
                        </div>
                    {% endif %}
                    <small style="color: var(--text); opacity: 0.7; display: block; margin-top: 0.25rem;">
                        Comment vous sentez-vous aujourd'hui ? (1-10)
                    </small>
                </div>

                <div>
                    <label for="{{ form.energy_level.id_for_label }}" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text);">
                        ⚡ {{ form.energy_level.label }}
                    </label>
                    {{ form.energy_level }}
                    {% if form.energy_level.errors %}
                        <div style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.25rem;">
                            {{ form.energy_level.errors }}
                        </div>
                    {% endif %}
                    <small style="color: var(--text); opacity: 0.7; display: block; margin-top: 0.25rem;">
                        Quel est votre niveau d'énergie ? (1-10)
                    </small>
                </div>

                <div>
                    <label for="{{ form.sleep_hours.id_for_label }}" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text);">
                        🌙 {{ form.sleep_hours.label }}
                    </label>
                    {{ form.sleep_hours }}
                    {% if form.sleep_hours.errors %}
                        <div style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.25rem;">
                            {{ form.sleep_hours.errors }}
                        </div>
                    {% endif %}
                    <small style="color: var(--text); opacity: 0.7; display: block; margin-top: 0.25rem;">
                        Combien d'heures avez-vous dormi ?
                    </small>
                </div>

                <div>
                    <label for="{{ form.productivity_score.id_for_label }}" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text);">
                        📈 {{ form.productivity_score.label }}
                    </label>
                    {{ form.productivity_score }}
                    {% if form.productivity_score.errors %}
                        <div style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.25rem;">
                            {{ form.productivity_score.errors }}
                        </div>
                    {% endif %}
                    <small style="color: var(--text); opacity: 0.7; display: block; margin-top: 0.25rem;">
                        Comment évaluez-vous votre productivité ? (1-10)
                    </small>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" 
                        style="flex: 1; background: var(--accent); color: white; padding: 0.75rem 1.5rem; border: none; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: opacity 0.3s;">
                    ✅ Enregistrer
                </button>
                <a href="{% url 'wellbeing:wellbeing_list' %}" 
                   style="flex: 1; text-align: center; background: #6c757d; color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600; transition: opacity 0.3s;">
                    ❌ Annuler
                </a>
            </div>
        </form>
    </div>

    <div class="feature-card" style="margin-top: 2rem; border: 2px solid var(--accent);">
        <h5 style="color: var(--card-title-color); margin-bottom: 1rem;">💡 Conseils</h5>
        <ul style="text-align: left; color: var(--card-body-color); line-height: 1.8;">
            <li>Soyez honnête dans vos évaluations pour obtenir des recommandations pertinentes</li>
            <li>Essayez de remplir votre enregistrement à la même heure chaque jour</li>
            <li>Les données collectées vous aideront à identifier des tendances</li>
        </ul>
    </div>
</div>
{% endblock %}
</file>

<file path="templates/frontoffice/pages/wellbeing/wellbeing_list.html">
{% extends 'frontoffice/layouts/base.html' %}
{% load static %}

{% block title %}Mes enregistrements de bien-être{% endblock %}

{% block content %}
<link rel="stylesheet" href="{% static 'css/main.css' %}">

<div style="max-width: 1200px; margin: 0 auto; padding: 3rem 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1 class="hero-title" style="font-size: 2.5rem; margin: 0;">Mes enregistrements</h1>
        <a href="{% url 'wellbeing:wellbeing_create' %}" 
           style="background: var(--accent); color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600; transition: opacity 0.3s;">
            + Nouvel enregistrement
        </a>
    </div>

    {% if messages %}
        {% for message in messages %}
        <div style="background: #d4edda; border-left: 4px solid #28a745; padding: 1rem; margin-bottom: 1rem; border-radius: 8px;">
            {{ message }}
        </div>
        {% endfor %}
    {% endif %}

    {% if records %}
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
            {% for record in records %}
            <div class="entry-card">
                <div style="background: var(--accent); color: white; padding: 1rem; border-radius: 12px 12px 0 0; margin: -1.5rem -1.5rem 1rem -1.5rem;">
                    <h5 style="margin: 0; font-size: 1.2rem; font-weight: 600;">📅 {{ record.date|date:"d/m/Y" }}</h5>
                </div>
                
                <div style="margin-bottom: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="color: var(--text); font-weight: 500;">😊 Humeur</span>
                        <span style="background: #3498db; color: white; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.9rem; font-weight: 600;">
                            {{ record.mood_score }}/10
                        </span>
                    </div>
                    <div style="background: #e0e0e0; height: 8px; border-radius: 4px; overflow: hidden;">
                        <div style="background: #3498db; height: 100%; width: {{ record.mood_score }}0%; transition: width 0.3s;"></div>
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="color: var(--text); font-weight: 500;">⚡ Énergie</span>
                        <span style="background: #f39c12; color: white; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.9rem; font-weight: 600;">
                            {{ record.energy_level }}/10
                        </span>
                    </div>
                    <div style="background: #e0e0e0; height: 8px; border-radius: 4px; overflow: hidden;">
                        <div style="background: #f39c12; height: 100%; width: {{ record.energy_level }}0%; transition: width 0.3s;"></div>
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--text); font-weight: 500;">🌙 Sommeil</span>
                        <span style="background: #95a5a6; color: white; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.9rem; font-weight: 600;">
                            {{ record.sleep_hours }}h
                        </span>
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="color: var(--text); font-weight: 500;">📈 Productivité</span>
                        <span style="background: #27ae60; color: white; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.9rem; font-weight: 600;">
                            {{ record.productivity_score }}/10
                        </span>
                    </div>
                    <div style="background: #e0e0e0; height: 8px; border-radius: 4px; overflow: hidden;">
                        <div style="background: #27ae60; height: 100%; width: {{ record.productivity_score }}0%; transition: width 0.3s;"></div>
                    </div>
                </div>

                {% if record.ai_summary %}
                <div style="background: #f8f9fa; padding: 0.75rem; border-radius: 8px; border-left: 3px solid var(--accent); margin-bottom: 1rem;">
                    <small style="color: var(--text);">🤖 {{ record.ai_summary|truncatewords:15 }}</small>
                </div>
                {% endif %}

                <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                    <a href="{% url 'wellbeing:wellbeing_detail' record.pk %}" 
                       style="flex: 1; text-align: center; padding: 0.5rem; background: var(--accent); color: white; text-decoration: none; border-radius: 6px; font-weight: 500; transition: opacity 0.3s;">
                        👁️ Détails
                    </a>
                    <a href="{% url 'wellbeing:wellbeing_update' record.pk %}" 
                       style="padding: 0.5rem 1rem; background: #6c757d; color: white; text-decoration: none; border-radius: 6px; transition: opacity 0.3s;">
                        ✏️
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div style="text-align: center; padding: 4rem 1rem;">
            <div style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.3;">📭</div>
            <h3 style="color: var(--text); margin-bottom: 0.5rem;">Aucun enregistrement</h3>
            <p style="color: var(--text); opacity: 0.7; margin-bottom: 2rem;">Commencez à suivre votre bien-être dès aujourd'hui</p>
            <a href="{% url 'wellbeing:wellbeing_create' %}" 
               style="display: inline-block; background: var(--accent); color: white; padding: 1rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 1.1rem;">
                + Créer mon premier enregistrement
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
</file>

